{
	"data": {
		"filename": "../data/processed/spy_processed_mini.csv",
		"columns": [
			"CLOSE",
			"VOLUME",
			"OPEN",
			"HIGH",
			"LOW"
		],
		"sequence_length": 50,
		"train_test_split": 0.8,
		"normalise": true
	},
	"training": {
		"epochs": 1,
		"batch_size": 32,
        "generator": false,
        "early_stopping_patience": 5,
        "monitor_metric": "accuracy"
	}, 
	"model": {
		"loss": "mse",
		"optimizer": "adam",
		"learning_rate": 0.001,
        "metrics":["mse", "mae", "accuracy"],
		"save_dir": "Lstm/saved_models",
		"layers": [
			{
				"type": "lstm",
				"neurons": 100,
				"input_timesteps": 49,
				"input_dim": 5,
				"return_seq": true
			},
			{
				"type": "dropout",
				"rate": 0.2
			},
			{
				"type": "lstm",
				"neurons": 100,
				"return_seq": true
			},
			{
				"type": "lstm",
				"neurons": 100,
				"return_seq": false
			},
			{
				"type": "dropout",
				"rate": 0.2
			},
			{
				"type": "dense",
				"neurons": 1,
				"activation": "linear"
			}
		]
	}
}