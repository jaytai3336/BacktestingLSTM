{
	"mode": "test",
	"data": {
		"filename": "../data/processed/spy_with_sentiment_with_predictions.csv",
		"columns": [
			"CLOSE",
			"VOLUME",
			"OPEN",
			"HIGH",
			"LOW",
			"MACD",
			"MACD_Signal",
			"MACD_Hist",
			"RSI_10",
			"BB_Std",
			"sentiment_score",
			"cluster",
			"y_pred"
		],
		"sequence_length": 100,
		"train_test_split": 0.85,
		"normalise": true
	},
	"training": {
		"epochs": 50,
		"batch_size": 20,
        "generator": false,
		"teaching": false,
        "early_stopping_patience": 10,
        "monitor_metric": "mse"
	}, 
	"model": {
		"loss": "mse",
		"optimizer": "adam",
		"learning_rate": 0.001,
        "metrics":["mse"],
		"save_dir": "Lstm/saved_models",
		"layers": [
			{
				"type": "lstm",
				"neurons": 128,
				"input_timesteps": 99,
				"input_dim": 13,
				"return_seq": true
			},
			{
				"type": "dense",
				"neurons":64,
				"activation": "relu"
			},
			{
				"type": "dropout",
				"rate": 0.2
			},
			{
				"type": "lstm",
				"neurons": 32
			},
			{
				"type": "dropout",
				"rate": 0.2
			},
			{
				"type": "dense",
				"neurons": 4,
				"activation": "relu",
				"return_seq": true
			},
			{
				"type": "dense",
				"neurons": 1,
				"activation": "linear"
			}
		]
	}
}